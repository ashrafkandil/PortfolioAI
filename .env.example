# Talking avatar - every setting is optional. With none set, the avatar answers
# in English from the site data, with no network calls and no cost.
# Copy to .env and fill in what you want to enable.

# LLM: any OpenAI-compatible chat API. Setting a model turns it on.
#   Free hosted:  OpenRouter models ending in ":free" (needs a free API key)
#   Free local:   Ollama -> AVATAR_LLM_BASE_URL=http://localhost:11434/v1
# AVATAR_LLM_MODEL=
# AVATAR_LLM_BASE_URL=https://openrouter.ai/api/v1
# AVATAR_LLM_API_KEY=

# Translation: self-hosted LibreTranslate
#   docker run -d -p 5000:5000 libretranslate/libretranslate --load-only en,ar,es,fr,de
# Without it, translation falls back to the LLM (if configured), else English only.
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=
