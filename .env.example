# Talking avatar - every setting is optional. With none set, the avatar answers
# in English from the site data, with no network calls and no cost.
# Copy to .env and fill in what you want to enable.

# Google Gemini (free tier) - the avatar's brain. Setting a key turns on:
#   - AI answers grounded in the site data
#   - voice questions: the mic records a WAV clip, Gemini transcribes and
#     answers it in one call (no browser speech-recognition service)
#   - translation for the language picker (LibreTranslate below wins if set)
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=                # optional: pin a model; otherwise a fallback chain is tried

# Translation: self-hosted LibreTranslate
#   docker run -d -p 5000:5000 libretranslate/libretranslate --load-only en,ar,fr
# Without it, translation falls back to Gemini (if configured), else English only.
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# Database location. Optional: with nothing set, the SQLite file lives at
# server/data/portfolio.db (gitignored). Point this at a persistent location -
# e.g. a mounted volume in production - so the data survives redeploys, and run
# "npm run seed" once to fill an empty database. After that the database is the
# source of truth: edit it with any SQLite tool and the site reflects it live,
# with no rebuild and no reseed. "npm run seed" is a no-op once data exists;
# "npm run seed:force" resets from server/seed-data.json. "npm run db:backup"
# writes a timestamped copy next to the database.
# DB_PATH=/var/lib/portfolio/portfolio.db
